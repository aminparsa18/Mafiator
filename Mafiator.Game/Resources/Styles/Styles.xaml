<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Mafiator.Game.Controls;assembly=Mafiator.Game">

    
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource Day3}, Dark={StaticResource Night3}}" />
        <!--<Setter Property="Shell.ForegroundColor" Value="{OnPlatform WinUI={StaticResource Primary}, Default={StaticResource White}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray200}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}" />-->
    </Style>

    <!--<Style TargetType="userControls:TransitionNavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource Day1}" />
        <Setter Property="BarTextColor" Value="White" />
    </Style>-->

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource Day1},Dark={StaticResource Night3}}" />
        <Setter Property="NavigationPage.HasNavigationBar" Value="False" />
    </Style>
    <!--<Style TargetType="userControls:ExtendedEntry">
        <Setter Property="TextColor" Value="{StaticResource EntryTextColor}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="PlaceholderColor" Value="#B5ADAD" />
        <Setter Property="InvalidLineColor" Value="{StaticResource Error}" />
        <Setter Property="IsTextPredictionEnabled" Value="False" />
    </Style>-->
    <!--<Style TargetType="Editor">
        <Setter Property="FontFamily" Value="{StaticResource NormalFont}" />
        <Setter Property="HeightRequest" Value="120" />
        <Setter Property="BackgroundColor" Value="Transparent" />

    </Style>
    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="{StaticResource NormalFont}" />
    </Style>-->
    
    <Style TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="OpenSansRegular"></Setter>
        <Setter Property="TextColor" Value="White" />
    </Style>
    
    <Style TargetType="Frame">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Padding" Value="8" />
    </Style>
    
    <Style TargetType="controls:PopupFrame">
        <Setter Property="CornerRadius" Value="48" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="VerticalOptions" Value="CenterAndExpand" />
        <Setter Property="Background" >
            <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                <GradientStop
                            Color="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night3}}"
                            Offset="0.0" />
                <GradientStop
                            Color="{AppThemeBinding Light={StaticResource Day2},Dark={StaticResource Night2}}"
                            Offset="0.25" />
            </LinearGradientBrush>
        </Setter>
    </Style>
    
    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="14" />
        <!--<Setter Property="androidSpecific:Button.UseDefaultShadow" Value="True" />-->
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night4}}" />
    </Style>
    
    <Style TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="CornerRadius" Value="30" />
    </Style>
    <!--<Style TargetType="controls:MTAdView">
        <Setter Property="HeightRequest" Value="90"/>
    </Style>-->
</ResourceDictionary>