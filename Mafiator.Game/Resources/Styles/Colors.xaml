<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--Day Mode-->
    <Color x:Key="Day1">#fafafa</Color>
    <Color x:Key="Day2">#ce95ca</Color>
    <Color x:Key="Day3">#944d87</Color>
    <Color x:Key="Day4">#45247b</Color>
    <Color x:Key="Day5">#250d3b</Color>
    <!--Night Mode-->
    <Color x:Key="Night1">#fafafa</Color>
    <Color x:Key="Night2">#1558a7</Color>
    <Color x:Key="Night3">#091754</Color>
    <Color x:Key="Night4">#0a0430</Color>
    <Color x:Key="Night5">#03010f</Color>

    <Color x:Key="PopupDayBackground">#E6788daa</Color>
    <Color x:Key="PopupNightBackground">#E66e5c8e</Color>

    <Color x:Key="PlaceHolderColor">#B3000000</Color>
    <Color x:Key="EntryTextColor">#212831</Color>
    <Color x:Key="HeaderColor">#707070</Color>
    <Color x:Key="Success">#7CB342</Color>
    <Color x:Key="Error">#FF204F</Color>
    <Color x:Key="Gem">#3EA163</Color>

</ResourceDictionary>