<Shell
    x:Class="Mafiator.Game.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mafiator.Game.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">
    
    <ShellContent
        ContentTemplate="{DataTemplate local:HomeView}"
        Route="HomeViewModel" />
    
    <ShellContent
        ContentTemplate="{DataTemplate local:SplashView}"
        Route="SplashViewModel" />

    <ShellContent
        ContentTemplate="{DataTemplate local:LoginView}"
        Route="LoginViewModel" />

    <ShellContent
        ContentTemplate="{DataTemplate local:ConfirmPhoneView}"
        Route="ConfirmPhoneViewModel" />

    <ShellContent
        ContentTemplate="{DataTemplate local:ProfilePictureView}"
        Route="ProfilePictureViewModel" />

    <ShellContent
        ContentTemplate="{DataTemplate local:HomeView}"
        Route="HomeViewModel" />

    <ShellContent
        ContentTemplate="{DataTemplate local:MyRoomsView}"
        Route="MyRoomsViewModel" />

    <ShellContent
        ContentTemplate="{DataTemplate local:RoomDetailView}"
        Route="RoomDetailViewModel" />

    <ShellContent
        ContentTemplate="{DataTemplate local:BarcodeScannerView}"
        Route="BarcodeScannerViewModel" />

    <ShellContent
        ContentTemplate="{DataTemplate local:SettingsView}"
        Route="SettingsViewModel" />

</Shell>