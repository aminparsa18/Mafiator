<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Mafiator.Game.Controls"
             x:Class="Mafiator.Game.Controls.ExtendedEntry">
    <VerticalStackLayout>
        <Grid>
            <Border x:Name="EntryBorder" StrokeThickness="1" Padding="8,0" BackgroundColor="{AppThemeBinding Light={StaticResource Day1}, Dark={StaticResource Night1}}">
                <controls:BorderlessEntry x:Name="EntryControl" 
                                          Focused="EntryControl_Focused" 
                                          Unfocused="EntryControl_Unfocused"/>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="36" />
                </Border.StrokeShape>
            </Border>
            <Label x:Name="PlaceHolderLabel" Margin="16,0" VerticalOptions="CenterAndExpand" TextColor="{StaticResource PlaceHolderColor}"/>
        </Grid>
        <Label x:Name="ErrorLabel" Margin="16,0" IsVisible="False" TextColor="{StaticResource Error}"/>
    </VerticalStackLayout>
</ContentView>
