<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Mafiator.Game.Controls"
             x:Class="Mafiator.Game.Controls.PopupHeader">
    <Grid HorizontalOptions="FillAndExpand">
        <VerticalStackLayout VerticalOptions="EndAndExpand" HorizontalOptions="FillAndExpand" Margin="16,0,0,0">
            <Label x:Name="TitleLabel" FontSize="Large" FontAttributes="Bold" />
            <Label x:Name="SubTitleLabel" />
        </VerticalStackLayout>
        <controls:CloseButton x:Name="PopupCloseIcon" HorizontalOptions="EndAndExpand"/>
    </Grid>
</ContentView>