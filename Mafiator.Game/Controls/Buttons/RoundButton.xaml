<Frame xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:effects="clr-namespace:MauiTouchEffect;assembly=MauiTouchEffect"
             x:Class="Mafiator.Game.Controls.Buttons.RoundButton"
             CornerRadius="100"
             WidthRequest="48"
             HeightRequest="48"
             effects:TouchEffect.PressedOpacity="0.2"
             effects:TouchEffect.PressedScale="1.2"
             effects:TouchEffect.AnimationEasing="{x:Static Easing.Linear}"
             effects:TouchEffect.AnimationDuration="400"
             BackgroundColor="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night2}}" />