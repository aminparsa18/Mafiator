<mopups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:base="clr-namespace:Mafiator.Game.ViewModels.Base"
                  xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
                  xmlns:animations="clr-namespace:Mopups.Animations;assembly=Mopups"
                  xmlns:viewModels="clr-namespace:Mafiator.Game.ViewModels"
                  xmlns:controls="clr-namespace:Mafiator.Game.Controls"
                  xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
                  base:ViewModelLocator.AutoWireViewModel="True"
                  x:Class="Mafiator.Game.Views.WaitingView"
                  x:DataType="viewModels:WaitingViewModel">
    <mopups:PopupPage.Animation>
        <animations:ScaleAnimation
            PositionIn="Center"
            PositionOut="Center"
            DurationIn="400"
            DurationOut="400"
            EasingIn="SpringOut"
            EasingOut="SpringIn"
            HasBackgroundAnimation="True" />
    </mopups:PopupPage.Animation>
    <mopups:PopupPage.Content>
        <controls:PopupFrame Margin="36" VerticalOptions="CenterAndExpand">
            <VerticalStackLayout Spacing="8">

                <skia:SKLottieView  WidthRequest="36"
                                    HeightRequest="36"
                                    Opacity="0.8"
                                    RepeatCount="-1"
                                    RepeatMode="Reverse"
                                    Source="loading.json"/>
                <Label Text="{Binding Message}" HorizontalOptions="CenterAndExpand"/>
            </VerticalStackLayout>
        </controls:PopupFrame>
    </mopups:PopupPage.Content>
</mopups:PopupPage>