<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:effects="clr-namespace:MauiTouchEffect;assembly=MauiTouchEffect"
             xmlns:base="clr-namespace:Mafiator.Game.ViewModels.Base"
             xmlns:controls="clr-namespace:Mafiator.Game.Controls"
             xmlns:buttons="clr-namespace:Mafiator.Game.Controls.Buttons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:resx="clr-namespace:Mafiator.Game.Resources.Texts"  
             xmlns:viewModels="clr-namespace:Mafiator.Game.ViewModels"
             x:Class="Mafiator.Game.Views.HomeView"
             base:ViewModelLocator.AutoWireViewModel="True"
             x:DataType="viewModels:HomeViewModel">
    <Grid>
        <Grid RowDefinitions="*,80" CompressedLayout.IsHeadless="true">
            <VerticalStackLayout>
                <HorizontalStackLayout x:Name="SettingGrid" Margin="0,36" HorizontalOptions="CenterAndExpand">
                    <buttons:SettingButton />
                    <buttons:LiveButton />
                    <buttons:HelpButton x:Name="HelpBtn" />
                    <buttons:ShareButton />
                </HorizontalStackLayout>

                <Grid Padding="16,0" 
                  ColumnDefinitions="*,*" RowDefinitions="*,*">
                    <Grid.ColumnSpacing>
                        <x:OnIdiom Phone="16" Tablet="24"></x:OnIdiom>
                    </Grid.ColumnSpacing>
                    <Grid.RowSpacing>
                        <x:OnIdiom Phone="20" Tablet="24"></x:OnIdiom>
                    </Grid.RowSpacing>
                    <Frame Padding="0" Margin="0" Grid.RowSpan="2" BackgroundColor="Black" CornerRadius="52"
                       Grid.Column="0" HorizontalOptions="FillAndExpand"
                           effects:TouchEffect.PressedScale="1.05" 
                           effects:TouchEffect.PressedOpacity="0.8" 
                           effects:TouchEffect.AnimationEasing="{x:Static Easing.Linear}" 
                           effects:TouchEffect.Command="{Binding AddRoomCommand}" >
                        <Grid>
                            <Image Source="create_room.png" Margin="8" Aspect="AspectFill" />
                            <VerticalStackLayout Padding="24,32" VerticalOptions="EndAndExpand">
                                <Label Text="{x:Static resx:AppResources.Create}" FontSize="32" VerticalOptions="EndAndExpand"
                                   FontFamily="OpenSansSemibold" />
                                <Label Text="{x:Static resx:AppResources.NewRoom}" FontSize="26" />
                            </VerticalStackLayout>
                        </Grid>

                    </Frame>

                    <Grid Grid.Row="0" Grid.Column="1" 
                          effects:TouchEffect.Command="{Binding JoinRoomCommand}" 
                          effects:TouchEffect.PressedScale="1.05" 
                          effects:TouchEffect.PressedOpacity="0.8"
                          effects:TouchEffect.AnimationEasing="{x:Static Easing.Linear}">
                        <Image Source="{AppThemeBinding Light=room_day.png, Dark=room_night.png}" Aspect="Fill" />
                        <VerticalStackLayout VerticalOptions="EndAndExpand"  Margin="20,16">
                            <Label Text="{x:Static resx:AppResources.Join}" FontSize="32" FontFamily="OpenSansSemibold" FontAttributes="Bold">
                            </Label>
                            <Label Text="{x:Static resx:AppResources.ARoom}" FontSize="28">
                            </Label>
                        </VerticalStackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer x:Name="JoinRoomTapped"  />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1"
                          effects:TouchEffect.Command="{Binding RoomHistoryCommand}" 
                          effects:TouchEffect.PressedScale="1.05" 
                          effects:TouchEffect.PressedOpacity="0.8"
                          effects:TouchEffect.AnimationEasing="{x:Static Easing.Linear}">
                        <Image Source="{AppThemeBinding Light=history_day.png, Dark=history_night.png}"
                           Aspect="Fill" />
                        <VerticalStackLayout VerticalOptions="EndAndExpand"  Margin="20,16">
                            <Label Text="{x:Static resx:AppResources.Rooms}" FontSize="32" FontAttributes="Bold" FontFamily="OpenSansSemibold">
                            </Label>
                            <Label FontSize="28" Margin="0,-12,0,0" Text="{x:Static resx:AppResources.History}">
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                    <!--<Grid Grid.Row="2"  Grid.ColumnSpan="2" 
                          effects:TouchEffect.Command="{Binding StoreCommand}"
                          effects:TouchEffect.PressedScale="1.05"
                          effects:TouchEffect.PressedOpacity="0.8"
                          effects:TouchEffect.AnimationEasing="{x:Static Easing.Linear}">
                        <Frame Padding="0" CornerRadius="16" BackgroundColor="Transparent">
                            <Image Source="{AppThemeBinding Light=store_day.png, Dark=store_night.png}"
                                   Aspect="Fill" />
                        </Frame>

                        <Label Text="{x:Static resx:AppResources.Store}" Margin="24,12" VerticalOptions="EndAndExpand" FontSize="32" FontAttributes="Bold" FontFamily="{StaticResource BoldFont}">
                        </Label>
                    </Grid>-->
                </Grid>
            </VerticalStackLayout>


        </Grid>
        <BoxView x:Name="OverlayBox" BackgroundColor="#000000" Opacity="0" IsVisible="False" />
        <Frame x:Name="ProfilePanel"
               BackgroundColor="{AppThemeBinding Light=#CCfafafa,Dark={StaticResource Night2}}" Padding="0"
               CornerRadius="45" VerticalOptions="EndAndExpand" SizeChanged="ProfilePanel_OnSizeChanged" >
            <VerticalStackLayout Margin="8,24,16,8">
                <!--<controls:CloseButton x:Name="CloseBtn" Opacity="0" HorizontalOptions="EndAndExpand"/>-->

                <Image x:Name="CloseBtn" Source="close.png"
                                       HorizontalOptions="EndAndExpand" Margin="8" WidthRequest="36" HeightRequest="36"
                                       Opacity="0">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="CloseBtn_OnClicked" />
                    </Image.GestureRecognizers>
                </Image>
                <!--first panel -->
                <Frame VerticalOptions="StartAndExpand" HorizontalOptions="CenterAndExpand" CornerRadius="42"
                           Padding="16" Margin="0,0,0,16">
                    <HorizontalStackLayout>
                        <toolkit:AvatarView
                                WidthRequest="80"
                                HeightRequest="80"
                                Margin="8"
                                ImageSource="{Binding User.Image}">
                        </toolkit:AvatarView>
                        <VerticalStackLayout>
                            <Label Text="{Binding User.DisplayName}" Margin="12,0,0,0" FontSize="16" FontFamily="OpenSansSemibold" />
                            <HorizontalStackLayout>
                                <Button BackgroundColor="Transparent" BorderWidth="1" FontSize="10" BorderColor="Transparent"
                                            Text="{x:Static resx:AppResources.EditProfile}" Padding="8,2" Margin="0" Command="{Binding EditProfileCommand}"/>
                                <Frame Margin="8,0" Padding="16,0">
                                    <HorizontalStackLayout>
                                        <Image Source="gem.png" WidthRequest="24" />
                                        <Label Text="{Binding User.Score}" VerticalOptions="CenterAndExpand"
                                                   TextColor="{StaticResource Gem}" FontSize="16" />
                                    </HorizontalStackLayout>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding StoreCommand}"></TapGestureRecognizer>
                                    </Frame.GestureRecognizers>
                                </Frame>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                            <GradientStop
                                    Color="{AppThemeBinding Light=#914B89,Dark={StaticResource Night2}}"
                                    Offset="0.0" />
                            <GradientStop
                                    Color="{AppThemeBinding Light=#45247A,Dark={StaticResource Night3}}"
                                    Offset="0.15" />
                        </LinearGradientBrush>
                    </Frame.Background>
                </Frame>

                <Frame CornerRadius="42" HorizontalOptions="CenterAndExpand" HeightRequest="146"
                       Padding="16,8">
                    <Grid ColumnDefinitions="*,*">
                        <controls:CircularProgressBar Stroke="15" Progress="{Binding UserStatus.MafiaWin}"
                                                          VerticalOptions="Center" HorizontalOptions="Center"
                                                          WidthRequest="60" HeightRequest="60" Color="#FEE9D7" />
                        <controls:CircularProgressBar Stroke="15" Progress="{Binding UserStatus.CitizenWin}"
                                                          VerticalOptions="Center" HorizontalOptions="Center"
                                                          WidthRequest="100" HeightRequest="100" Color="#F9BF8F" />
                        <controls:CircularProgressBar Stroke="15" Progress="{Binding UserStatus.TotalWin}"
                                                          VerticalOptions="Center" HorizontalOptions="Center"
                                                          WidthRequest="140" HeightRequest="140" Color="#E2434B" />
                        <VerticalStackLayout Grid.Column="1" Margin="8,0,0,0" VerticalOptions="CenterAndExpand">
                            <HorizontalStackLayout>
                                <BoxView CornerRadius="36" VerticalOptions="CenterAndExpand" WidthRequest="24"
                                         HeightRequest="24" Color="#E2434B" />
                                <Label VerticalOptions="CenterAndExpand" Margin="8,0,0,0" Text="{x:Static resx:AppResources.WinAsMafia}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout>
                                <BoxView CornerRadius="36" VerticalOptions="CenterAndExpand" WidthRequest="24"
                                         HeightRequest="24" Color="#F9BF8F" />
                                <Label VerticalOptions="CenterAndExpand" Margin="8,0,0,0" Text="{x:Static resx:AppResources.WinAsCitizen}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout>
                                <BoxView CornerRadius="36" VerticalOptions="CenterAndExpand" WidthRequest="24"
                                         HeightRequest="24" Color="#FEE9D7" />
                                <Label VerticalOptions="CenterAndExpand" Margin="8,0,0,0" Text="{x:Static resx:AppResources.TotalWin}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop
                                Color="{AppThemeBinding Light=#914B89,Dark={StaticResource Night2}}"
                                Offset="0.0" />
                            <GradientStop
                                Color="{AppThemeBinding Light=#45247A,Dark={StaticResource Night3}}"
                                Offset="0.25" />
                        </LinearGradientBrush>
                    </Frame.Background>
                </Frame>
                <Button Margin="8" Text="{x:Static resx:AppResources.SignOut}" Command="{Binding SignOutCommand}">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop
                                Color="{AppThemeBinding Light={StaticResource Day3},Dark={StaticResource Night3}}"
                                Offset="0.0" />
                            <GradientStop
                                Color="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night4}}"
                                Offset="0.55" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </VerticalStackLayout>
            <Frame.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop
                        Color="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night3}}"
                        Offset="0.0" />
                    <GradientStop
                        Color="{AppThemeBinding Light={StaticResource Day2},Dark={StaticResource Night2}}"
                        Offset="0.5" />
                </LinearGradientBrush>
            </Frame.Background>
        </Frame>

        <toolkit:AvatarView
            x:Name="ProfileImage"
            WidthRequest="60"
            HeightRequest="60"
            Margin="20"
            HorizontalOptions="CenterAndExpand"
            VerticalOptions="EndAndExpand"
            ImageSource="{Binding User.Image}">
            <toolkit:AvatarView.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Up,Down" Swiped="SwipeGestureRecognizer_OnSwiped" />
                <TapGestureRecognizer Tapped="TapGestureRecognizer_OnTapped_" />
            </toolkit:AvatarView.GestureRecognizers>
        </toolkit:AvatarView>
    </Grid>
</ContentPage>