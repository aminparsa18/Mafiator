<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:userControls="clr-namespace:MafiatorApp.UserControls;assembly=MafiatorApp"
                 xmlns:base="clr-namespace:MafiatorApp.ViewModels.Base;assembly=MafiatorApp"
                 xmlns:converters="clr-namespace:MafiatorApp.Converters;assembly=MafiatorApp"
                 xmlns:pages="http://rotorgames.com"
                 xmlns:templates="clr-namespace:MafiatorApp.Views.Templates;assembly=MafiatorApp"
                 xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
                 x:Class="MafiatorApp.Views.NewGameView"
                 CloseWhenBackgroundIsClicked="True"
                 base:ViewModelLocator.AutoWireViewModel="true">
    <ContentPage.Resources>
        <converters:ToggleConverter x:Key="ToggleConverter" />
    </ContentPage.Resources>
    <pages:PopupPage.Animation>
        <pages:MoveAnimation
            PositionIn="Bottom"
            PositionOut="Bottom"
            DurationIn="400"
            DurationOut="400"
            EasingIn="SpringOut"
            EasingOut="SpringIn"
            HasBackgroundAnimation="True" />
    </pages:PopupPage.Animation>
    <pages:PopupPage.Content>
        <StackLayout>
            <Frame
                CornerRadius="52" Margin="16" Padding="0"
                VerticalOptions="CenterAndExpand">
                <StackLayout>
                    <StackLayout Orientation="Horizontal" Margin="16">
                        <StackLayout VerticalOptions="EndAndExpand" Margin="16,0,0,0">
                            <Label Text="{xct:Translate Start}" FontSize="Large" FontAttributes="Bold" />
                            <Label Text="{xct:Translate NewGame}" />
                        </StackLayout>
                        <templates:CloseButton />
                    </StackLayout>

                    <userControls:ExtendedEntry
                        Keyboard="Numeric"
                        Placeholder="{xct:Translate GamePlayersCount}"
                        Text="{Binding Capacity.Value}"
                        IsValid="{Binding IsCapacityValid,Mode=TwoWay}"
                        Margin="16,0"
                        Errors="{Binding Capacity.Errors}" />
                    <Grid IsVisible="{Binding IsImmediate,Converter={StaticResource ToggleConverter}}">
                        <DatePicker IsVisible="False" Date="{Binding Date,Mode=TwoWay}"
                                    Unfocused="GameDatePicker_OnUnfocused" x:Name="GameDatePicker" />

                        <userControls:ExtendedEntry
                            x:Name="DateInput"
                            Placeholder="{xct:Translate GameStartsAt}"
                            Text="{Binding Date}"
                            Margin="16,0"
                            Focused="DateInput_OnFocused" />
                    </Grid>
                    <TimePicker x:Name="GameTimePicker" IsVisible="False"
                                PropertyChanged="GameTimePicker_OnPropertyChanged"
                                Unfocused="GameTimePicker_OnUnfocused" />

                    <StackLayout Orientation="Horizontal" Margin="16,0,16,16">
                        <CheckBox IsChecked="{Binding IsImmediate,Mode=TwoWay}"/>
                        <Label Text="{xct:Translate StartImmediately}" VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                    <StackLayout Orientation="Horizontal" Margin="16,0,16,16">
                        <CheckBox IsChecked="{Binding IsPublic,Mode=TwoWay}" />
                        <Label Text="{xct:Translate PublicLiveStream}" VerticalOptions="CenterAndExpand" />
                        <ImageButton Source="help.png" BackgroundColor="Transparent" WidthRequest="24"
                                     Aspect="AspectFit" Command="{Binding PrivateHelpCommand}" />
                    </StackLayout>
                    <Grid VerticalOptions="EndAndExpand">
                        <Frame
                            BackgroundColor="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night4}}"
                            CornerRadius="52" Padding="0">
                            <StackLayout>
                                <StackLayout Padding="16">
                                    <StackLayout Orientation="Horizontal">
                                        <Label Text="{xct:Translate AddRoles}" FontSize="Large" FontAttributes="Bold" />
                                        <Image Source="arrow_up.png" HorizontalOptions="EndAndExpand" Margin="16,0" />
                                    </StackLayout>
                                    <Label
                                        Text="{xct:Translate SpecifyRoles}"
                                        FontSize="Small" />
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer x:Name="AddByCodeTap" Command="{Binding SetRolesCommand}" />
                                    </StackLayout.GestureRecognizers>
                                </StackLayout>
                                <StackLayout
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Day5},Dark={StaticResource Night5}}"
                                    HeightRequest="48">
                                    <Label VerticalOptions="CenterAndExpand" Text="{xct:Translate Start}"
                                           HorizontalOptions="CenterAndExpand" FontAttributes="Bold" FontSize="Large" />
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SaveGameCommand}" />
                                    </StackLayout.GestureRecognizers>
                                </StackLayout>

                            </StackLayout>
                        </Frame>
                    </Grid>

                </StackLayout>
                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop
                            Color="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night3}}"
                            Offset="0.0" />
                        <GradientStop
                            Color="{AppThemeBinding Light={StaticResource Day2},Dark={StaticResource Night2}}"
                            Offset="0.25" />
                    </LinearGradientBrush>
                </Frame.Background>
            </Frame>

        </StackLayout>
    </pages:PopupPage.Content>
</pages:PopupPage>