<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
                 xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup"
                 xmlns:base="clr-namespace:MafiatorApp.ViewModels.Base;assembly=MafiatorApp"
                 xmlns:forms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
                 xmlns:transformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
                 xmlns:forms1="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
                 xmlns:templates="clr-namespace:MafiatorApp.Views.Templates;assembly=MafiatorApp"
                 xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
                 x:Class="MafiatorApp.Views.NewMemberView"
                 CloseWhenBackgroundIsClicked="True"
                 base:ViewModelLocator.AutoWireViewModel="True">
    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            PositionIn="Bottom"
            PositionOut="Bottom"
            DurationIn="400"
            DurationOut="400"
            EasingIn="SinOut"
            EasingOut="SinIn"
            HasBackgroundAnimation="True" />
    </pages:PopupPage.Animation>
    <pages:PopupPage.Content>
        <ScrollView>
        <StackLayout>
            <Frame
                
                CornerRadius="52" Margin="48" Padding="0" VerticalOptions="CenterAndExpand">
                <StackLayout>
                    <StackLayout Orientation="Horizontal" Margin="16">
                        <StackLayout VerticalOptions="EndAndExpand" Margin="16,0,0,0">
                                <Label Text="{xct:Translate Add}" FontSize="Large" FontAttributes="Bold" />
                            <Label Text="{xct:Translate YourFriends}" />
                        </StackLayout>
                        <templates:CloseButton/>
                        </StackLayout>
                    <StackLayout Margin="16">
                     
                        <Frame Padding="0">
                            <SearchBar Placeholder="{xct:Translate Username}"
                                       BackgroundColor="{AppThemeBinding Light={StaticResource Day1},Dark={StaticResource Night1}}"
                                       CancelButtonColor="{StaticResource Error}" Text="{Binding Name.Value,Mode=TwoWay}"
                                       SearchCommand="{Binding SearchMemberCommand}" />
                        </Frame>
                        <StackLayout BindableLayout.ItemsSource="{Binding Members}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <StackLayout Orientation="Horizontal">
                                        <forms:CachedImage
                                            x:Name="ProfileImage"
                                            WidthRequest="60"
                                            HeightRequest="60"
                                            DownsampleToViewSize="True"
                                            Margin="8"
                                            Aspect="Fill"
                                            Source="{Binding Image}"
                                            LoadingPlaceholder="{AppThemeBinding Light=profile_day.png,Dark=profile_night.png}"
                                            ErrorPlaceholder="{AppThemeBinding Light=profile_day.png,Dark=profile_night.png}">
                                            <forms:CachedImage.Transformations>
                                                <transformations:CircleTransformation />
                                            </forms:CachedImage.Transformations>
                                        </forms:CachedImage>
                                        <Label VerticalOptions="CenterAndExpand" FontSize="18" Text="{Binding DisplayName}" />
                                            <ImageButton WidthRequest="30" Source="close.png" HorizontalOptions="EndAndExpand" CommandParameter="{Binding Id}" Clicked="ImageButton_OnClicked"></ImageButton>
                                    </StackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>

                        <StackLayout Orientation="Horizontal" Margin="8">
                            <BoxView HeightRequest="1" Margin="4,0" HorizontalOptions="FillAndExpand"
                                     VerticalOptions="CenterAndExpand" BackgroundColor="White" />
                            <Label Text="{xct:Translate Or}" />
                            <BoxView HeightRequest="1" Margin="4,0" HorizontalOptions="FillAndExpand"
                                     VerticalOptions="CenterAndExpand" BackgroundColor="White" />
                        </StackLayout>
                    </StackLayout>
                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night4}}"
                           CornerRadius="52" Padding="0">
                        <StackLayout>
                            <StackLayout Padding="16">
                                <StackLayout Orientation="Horizontal" Margin="16,0,0,0">
                                    <Label Text="{xct:Translate ScanBarcode}" FontSize="Large" FontAttributes="Bold" />
                                        <forms1:SvgCachedImage Source="scan.svg" WidthRequest="36" HeightRequest="36" HorizontalOptions="EndAndExpand"
                                                                          Margin="16,0" />
                                </StackLayout>
                                <Label
                                    Text="{xct:Translate ScanBarcodeDesc}"
                                    FontSize="Small" />
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ScanQrCommand}" />
                                </StackLayout.GestureRecognizers>
                            </StackLayout>
                            <StackLayout
                                BackgroundColor="{AppThemeBinding Light={StaticResource Day5},Dark={StaticResource Night5}}"
                                HeightRequest="48">
                                <Label VerticalOptions="CenterAndExpand" Text="{xct:Translate Add}"
                                       HorizontalOptions="CenterAndExpand" FontAttributes="Bold" FontSize="Large" />
                                <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AddMemberCommand}" />
                                </StackLayout.GestureRecognizers>
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                </StackLayout>
                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop
                            Color="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night3}}"
                            Offset="0.0" />
                        <GradientStop
                            Color="{AppThemeBinding Light={StaticResource Day2},Dark={StaticResource Night2}}"
                            Offset="0.25" />
                    </LinearGradientBrush>
                </Frame.Background>
                </Frame>
        </StackLayout>
        </ScrollView>
    </pages:PopupPage.Content>
</pages:PopupPage>