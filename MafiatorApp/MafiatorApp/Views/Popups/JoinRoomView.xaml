<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
                 xmlns:forms="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
                 xmlns:controls="clr-namespace:MafiatorApp.Views.Controls;assembly=MafiatorApp"
                 xmlns:base="clr-namespace:MafiatorApp.ViewModels.Base;assembly=MafiatorApp"
                 xmlns:viewModels="clr-namespace:MafiatorApp.ViewModels;assembly=MafiatorApp"
                 xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup"
                 xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
                 x:Class="MafiatorApp.Views.JoinRoomView"
                 CloseWhenBackgroundIsClicked="True"
                 base:ViewModelLocator.AutoWireViewModel="True"
                 x:DataType="viewModels:JoinRoomViewModel">
    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            PositionIn="Right"
            PositionOut="Right"
            DurationIn="400"
            DurationOut="400"
            EasingIn="SinOut"
            EasingOut="SinIn"
            HasBackgroundAnimation="True" />
    </pages:PopupPage.Animation>
    <pages:PopupPage.Content>
        <StackLayout>
            <controls:PopupFrame Margin="16">
                <StackLayout>
                    <controls:PopupHeader TitleText="Join" SubTitleText="room"/>
                    <StackLayout Margin="16">
                    <controls:ExtendedEntry
                        x:Name="NameInput"
                        Text="{Binding Code.Value,Mode=TwoWay}"
                        Placeholder="{xct:Translate RoomCode}"
                        FontSize="Medium">
                        <controls:ExtendedEntry.HorizontalOptions>
                            <OnIdiom
                                x:TypeArguments="LayoutOptions"
                                Desktop="Center"
                                Tablet="Center"
                                Phone="FillAndExpand" />
                        </controls:ExtendedEntry.HorizontalOptions>
                        <controls:ExtendedEntry.WidthRequest>
                            <OnIdiom
                                x:TypeArguments="x:Double"
                                Desktop="350"
                                Tablet="320" />
                        </controls:ExtendedEntry.WidthRequest>
                    </controls:ExtendedEntry>
                    <StackLayout Orientation="Horizontal" Margin="8">
                        <BoxView HeightRequest="1" Margin="4,0" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" BackgroundColor="White"></BoxView>
                         <Label Text="{xct:Translate Or}" ></Label>
                            <BoxView HeightRequest="1" Margin="4,0" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" BackgroundColor="White"></BoxView>
                    </StackLayout>
                    </StackLayout>
                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night4}}" CornerRadius="52" Padding="0">
                        <StackLayout>
                            <StackLayout Padding="16">
                                <StackLayout Orientation="Horizontal">
                                    <Label Text="{xct:Translate ScanBarcode}" FontSize="Large" FontAttributes="Bold" />
                                    <forms:SvgCachedImage Source="scan.svg" WidthRequest="36" HeightRequest="36" HorizontalOptions="EndAndExpand"
                                                           Margin="16,0" >
                                    </forms:SvgCachedImage>
                                </StackLayout>
                                <Label
                                    Text="{xct:Translate RoomCodeDesc}"
                                    FontSize="Small" />
                            </StackLayout>
                            <StackLayout BackgroundColor="{AppThemeBinding Light={StaticResource Day5},Dark={StaticResource Night5}}" HeightRequest="48">
                                <Label VerticalOptions="CenterAndExpand" Text="{xct:Translate Join}"
                                       HorizontalOptions="CenterAndExpand" FontAttributes="Bold" FontSize="Large" />
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding JoinRoomCommand}"></TapGestureRecognizer>
                                </StackLayout.GestureRecognizers>
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                </StackLayout>
            </controls:PopupFrame>
        </StackLayout>
    </pages:PopupPage.Content>
</pages:PopupPage>