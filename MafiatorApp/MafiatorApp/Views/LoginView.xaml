                    <Grid VerticalOptions="EndAndExpand" ColumnDefinitions="*,*" Margin="48,16">
                        <Button x:Name="LoginBtn" Text="{xct:Translate Login}" Grid.Column="1" Margin="-16,0,16,0" BackgroundColor="#232228"
                                Clicked="LoginBtn_OnClicked" />
                        <Button x:Name="RegisterBtn" Text="{xct:Translate Register}" Margin="16,0,-16,0" 
                                BackgroundColor="#707070" Clicked="RegisterBtn_OnClicked" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,*" Margin="48,0">
                        <BoxView HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" HeightRequest="1"
                                 BackgroundColor="#707070" />
                        <Label Grid.Column="1" Text="{xct:Translate Or}" TextColor="#707070" Margin="8,0" />
                        <BoxView Grid.Column="2" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"
                                 HeightRequest="1" BackgroundColor="#707070" />
                    </Grid>
                    <Button x:Name="GoogleBtn" Margin="48,16" Text="{xct:Translate GoogleSignIn}" Command="{Binding GoogleCommand}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="{AppThemeBinding Light={StaticResource Day3},Dark={StaticResource Night3}}"
                                              Offset="0.0" />
                                <GradientStop Color="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night4}}"
                                              Offset="0.25" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button x:Name="FacebookBtn" Margin="48,0,48,16" Text="{xct:Translate FacebookSignIn}" Command="{Binding FacebookCommand}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="{AppThemeBinding Light={StaticResource Day3},Dark={StaticResource Night3}}"
                                              Offset="0.0" />
                                <GradientStop Color="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night4}}"
                                              Offset="0.25" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackLayout>
            </ScrollView>
           
