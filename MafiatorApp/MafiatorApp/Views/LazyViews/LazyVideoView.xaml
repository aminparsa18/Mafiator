<ContentView xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="http://xamarin.com/schemas/2020/toolkit"
             x:Class="MafiatorApp.Views.LazyViews.LazyVideoView">
    <ContentView.Content>
        <views:MediaElement x:Name="VideoElement" Aspect="AspectFill"
                            ShowsPlaybackControls="False" AutoPlay="True"  MediaOpened="VideoElement_OnMediaOpened" IsLooping="True"/>
    </ContentView.Content>
</ContentView>