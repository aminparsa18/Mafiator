<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:transformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
             xmlns:forms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
             xmlns:effects="clr-namespace:MafiatorApp.Effects;assembly=MafiatorApp"
             xmlns:base="clr-namespace:MafiatorApp.ViewModels.Base;assembly=MafiatorApp"
             xmlns:userControls="clr-namespace:MafiatorApp.UserControls;assembly=MafiatorApp"
             xmlns:forms1="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
             xmlns:converters="clr-namespace:MafiatorApp.Converters;assembly=MafiatorApp"
             xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
             xmlns:viewModels="clr-namespace:MafiatorApp.ViewModels;assembly=MafiatorApp"
             x:Class="MafiatorApp.Views.HomeView"
             base:ViewModelLocator.AutoWireViewModel="True"
             x:DataType="viewModels:HomeViewModel">
    <ContentPage.Resources>
        <converters:ProfileImageConverter x:Key="ProfileImageConverter"/>
    </ContentPage.Resources>
    <Grid>
        <Grid RowDefinitions="*,64" CompressedLayout.IsHeadless="true">
            <StackLayout>
                <StackLayout Orientation="Horizontal" x:Name="SettingGrid" Margin="0,36" MinimumHeightRequest="40" HorizontalOptions="CenterAndExpand">
                    <Frame x:Name="SettingBtn" Margin="4,0"  xct:TouchEffect.Command="{Binding SettingsCommand}"
                   CornerRadius="500" WidthRequest="30" HeightRequest="30" Padding="6"  BackgroundColor="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night2}}">
                        <Path
                    Data="M610.48,493.537H613M596.68,487l-1.68.044m1.68-.044a2.4,2.4,0,1,0,2.4-2.4A2.4,2.4,0,0,0,596.68,487Zm5.489.044H613m-8.2-6.493H595m18,0h-2.52M595,493.537h9.8m5.079.063a2.4,2.4,0,1,1-2.4-2.4A2.4,2.4,0,0,1,609.88,493.6Zm0-13.2a2.4,2.4,0,1,1-2.4-2.4A2.4,2.4,0,0,1,609.88,480.4Z"
                    Stroke="#FFF"
                    StrokeThickness="3"
                    WidthRequest="24"
                    HeightRequest="24"
                    HorizontalOptions="CenterAndExpand"
                    Aspect="Uniform"
                    StrokeLineCap="Round">
                            <Path.RenderTransform>
                                <TranslateTransform X="-594.231" Y="-477.25" />
                            </Path.RenderTransform>
                        </Path>
                    </Frame>
                    <!--<Frame x:Name="LiveBtn" WidthRequest="30" HeightRequest="30" Padding="6" Margin="4,0"
                   CornerRadius="500"  BackgroundColor="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night2}}">
                        <Path
                        Data="M817.353,490.05l-.73.171Zm0-6.1-.73-.171Zm17.294,0-.73.172Zm0,6.1-.73-.172Zm-5.6,5.6-.172-.73Zm-6.1,0,.172-.73Zm0-17.294.172.73Zm6.1,0-.172.73Zm-6.921,11.768a.75.75,0,0,0,1.5,0Zm1.5-4.161a.75.75,0,0,0-1.5,0Zm4.742,4.161a.75.75,0,0,0,1.5,0Zm1.5-3.121a.75.75,0,0,0-1.5,0Zm-4.621,2.081a.75.75,0,0,0,1.5,0Zm1.5-5.2a.75.75,0,0,0-1.5,0Zm-8.667,6a12.6,12.6,0,0,1,0-5.756l-1.46-.343a14.1,14.1,0,0,0,0,6.442Zm15.834-5.756a12.6,12.6,0,0,1,0,5.756l1.46.343a14.1,14.1,0,0,0,0-6.442Zm-5.039,10.795a12.6,12.6,0,0,1-5.756,0l-.343,1.46a14.1,14.1,0,0,0,6.442,0Zm-5.756-15.834a12.6,12.6,0,0,1,5.756,0l.343-1.46a14.1,14.1,0,0,0-6.442,0Zm0,15.834a6.764,6.764,0,0,1-5.039-5.039l-1.46.343a8.258,8.258,0,0,0,6.156,6.156Zm6.1,1.46a8.258,8.258,0,0,0,6.156-6.156l-1.46-.343a6.764,6.764,0,0,1-5.039,5.039Zm-.343-17.294a6.764,6.764,0,0,1,5.039,5.039l1.46-.343a8.258,8.258,0,0,0-6.156-6.156Zm-6.1-1.46a8.258,8.258,0,0,0-6.156,6.156l1.46.343a6.764,6.764,0,0,1,5.039-5.039Zm.85,12.5V485.96h-1.5v4.161Zm6.242,0V487h-1.5v3.121Zm-3.121-1.04v-5.2h-1.5v5.2Z"
                        Stroke="#FFF"
                        Fill="#FFF"
                        StrokeThickness="1"
                        WidthRequest="24"
                        HeightRequest="24"
                        Aspect="Uniform">
                        </Path>
                    </Frame>-->
                    <Frame x:Name="HelpBtn"  WidthRequest="30" HeightRequest="30" Padding="6" Margin="4,0"
                   CornerRadius="500"  BackgroundColor="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night2}}">
                        <Grid WidthRequest="34" HeightRequest="34">
                            <Path
                        Data="M822.95,569.647a7.51,7.51,0,0,1-5.6-5.6,13.343,13.343,0,0,1,0-6.1,7.51,7.51,0,0,1,5.6-5.6,13.343,13.343,0,0,1,6.1,0,7.51,7.51,0,0,1,5.6,5.6,13.343,13.343,0,0,1,0,6.1,7.51,7.51,0,0,1-5.6,5.6A13.343,13.343,0,0,1,822.95,569.647Z"
                        Stroke="#FFF"
                        StrokeThickness="3"
                        Aspect="Uniform">
                                <Path.RenderTransform>
                                    <TranslateTransform X="-816.245" Y="-551.245" />
                                </Path.RenderTransform>
                            </Path>
                            <Path Data=" M 0, 1 a 1,1 0 1,0 2,0 a 1,1 0 1,0 -2,0"
                          Stroke="#fff"
                          Fill="#fff"
                          HorizontalOptions="CenterAndExpand"
                          Margin="0,14,0,0"
                          WidthRequest="4"
                          StrokeThickness="2"
                          Aspect="Uniform">
                                <Path.RenderTransform>
                                    <TranslateTransform X="-816.245" Y="-551.245" />
                                </Path.RenderTransform>
                            </Path>
                            <Path Data="M824,559v-.5a2,2,0,0,1,2-2h0a2,2,0,0,1,2,2v.121a2.12,2.12,0,0,1-.621,1.5L826,561.5"
                          Stroke="#fff"
                          StrokeThickness="3"
                          Aspect="Uniform"
                          HorizontalOptions="CenterAndExpand"
                          VerticalOptions="StartAndExpand"
                          Margin="0,6,0,0"
                          WidthRequest="12"
                          HeightRequest="12"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round">
                                <Path.RenderTransform>
                                    <TranslateTransform X="-816.245" Y="-551.245" />
                                </Path.RenderTransform>

                            </Path>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding HelpCommand}"></TapGestureRecognizer>
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Frame x:Name="ShareBtn"  WidthRequest="30" HeightRequest="30" Padding="6" Margin="4,0"
                   CornerRadius="500"  BackgroundColor="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night2}}">
                        <Grid WidthRequest="34" HeightRequest="34" HorizontalOptions="CenterAndExpand">
                            <Path
                        Data="M1044.11,257.329l.35-.661Zm9.32,4.98-.35.661Zm0,5.406.35.662Zm-9.32,4.958-.35-.662h0Zm-3.96-3.627-.72-.216Zm-.01-8.1-.72.215Zm4.19,4.815a.75.75,0,0,0,0-1.5Zm-.57-7.775,9.32,4.979.71-1.323-9.33-4.979Zm9.32,9.062-9.32,4.958.7,1.324,9.32-4.958Zm-12.22,2.209,1.22-4.03-1.44-.432-1.21,4.03Zm1.22-4.461-1.22-4.065-1.44.43,1.22,4.065Zm-.72.965h2.97v-1.5h-2.97Zm2.4,6.245a1.906,1.906,0,0,1-2.25-.3,2.359,2.359,0,0,1-.65-2.447l-1.43-.432a3.866,3.866,0,0,0,1.06,3.986,3.412,3.412,0,0,0,3.97.519Zm9.32-9.041a2.366,2.366,0,0,1,0,4.083l.7,1.324a3.864,3.864,0,0,0,.01-6.73Zm-8.62-6.3a3.408,3.408,0,0,0-3.97.513,3.848,3.848,0,0,0-1.07,3.985l1.44-.43a2.355,2.355,0,0,1,.64-2.447,1.921,1.921,0,0,1,2.26-.3Z"
                        Stroke="#FFF"
                        StrokeThickness="1.5"
                        Fill="#fff"
                        Margin="2,0,0,0"
                        HorizontalOptions="CenterAndExpand"
                        WidthRequest="24"
                        HeightRequest="24"
                        Aspect="Uniform">
                                <Path.RenderTransform>
                                    <TranslateTransform X="-1039.247" Y="-256.249" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Frame>

                </StackLayout>
        

            <Grid Padding="16,0" 
                  ColumnDefinitions="*,*" RowDefinitions="*,*">
                <Grid.ColumnSpacing>
                    <x:OnIdiom Phone="16" Tablet="24"></x:OnIdiom>
                </Grid.ColumnSpacing>
                <Grid.RowSpacing>
                    <x:OnIdiom Phone="20" Tablet="24"></x:OnIdiom>
                </Grid.RowSpacing>
                    <Frame Padding="0" Margin="0" Grid.RowSpan="2" BackgroundColor="Black" CornerRadius="52"
                       Grid.Column="0" HorizontalOptions="FillAndExpand" xct:TouchEffect.PressedScale="1.05" xct:TouchEffect.PressedOpacity="0.8" xct:TouchEffect.AnimationEasing="Linear" xct:TouchEffect.Command="{Binding AddRoomCommand}" >
                    <Grid>
                        <Image Source="create_room.png" Margin="8" Aspect="AspectFill" />
                        <StackLayout Padding="24,32">
                            <Label Text="{xct:Translate Create}" FontSize="32" VerticalOptions="EndAndExpand"
                                   FontFamily="{StaticResource BoldFont}" />
                            <Label Text="{xct:Translate NewRoom}" FontSize="26" Margin="0,-12,0,0" />
                        </StackLayout>
                    </Grid>

                </Frame>

                <Grid Grid.Row="0" Grid.Column="1" xct:TouchEffect.Command="{Binding JoinRoomCommand}" xct:TouchEffect.PressedScale="1.05" xct:TouchEffect.PressedOpacity="0.8" xct:TouchEffect.AnimationEasing="Linear">
                    <Image Source="{AppThemeBinding Light=room_day.png, Dark=room_night.png}" Aspect="Fill" />
                    <StackLayout VerticalOptions="EndAndExpand"  Margin="20,16">
                        <Label Text="{xct:Translate Join}" FontSize="32" FontFamily="{StaticResource BoldFont}" FontAttributes="Bold">
                            <Label.Effects>
                                <effects:ShadowEffect Radius="5" Color="Black" DistanceX="5" DistanceY="5" />
                            </Label.Effects>
                        </Label>
                            <Label Text="{xct:Translate ARoom}" FontSize="28" Margin="0,-58,0,0">
                                <Label.Effects>
                                <effects:ShadowEffect Radius="5" Color="Black" DistanceX="5" DistanceY="5" />
                            </Label.Effects>
                        </Label>
                    </StackLayout>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer x:Name="JoinRoomTapped"  />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1" xct:TouchEffect.Command="{Binding RoomHistoryCommand}" xct:TouchEffect.PressedScale="1.05" xct:TouchEffect.PressedOpacity="0.8" xct:TouchEffect.AnimationEasing="Linear">
                    <Image Source="{AppThemeBinding Light=history_day.png, Dark=history_night.png}"
                           Aspect="Fill" />
                    <StackLayout VerticalOptions="EndAndExpand"  Margin="20,16">
                        <Label Text="{xct:Translate Rooms}" FontSize="32" FontAttributes="Bold" FontFamily="{StaticResource BoldFont}">
                            <Label.Effects>
                                <effects:ShadowEffect Radius="5" Color="Black" DistanceX="5" DistanceY="5" />
                            </Label.Effects>
                        </Label>
                        <Label FontSize="28" Margin="0,-12,0,0" Text="{xct:Translate History}">
                            <Label.Effects>
                                <effects:ShadowEffect Radius="5" Color="Black" DistanceX="5" DistanceY="5" />
                            </Label.Effects>
                        </Label>
                    </StackLayout>
                </Grid>
                <Grid Grid.Row="2"  Grid.ColumnSpan="2" xct:TouchEffect.Command="{Binding StoreCommand}" xct:TouchEffect.PressedScale="1.05" xct:TouchEffect.PressedOpacity="0.8" xct:TouchEffect.AnimationEasing="Linear">
                    <Frame Padding="0" CornerRadius="16">
                        <Image Source="store.png"
                               Aspect="Fill" />
                        </Frame>
                    
                        <Label Text="{xct:Translate Store}" Margin="12" VerticalOptions="EndAndExpand" FontSize="32" FontAttributes="Bold" FontFamily="{StaticResource BoldFont}">
                            <Label.Effects>
                                <effects:ShadowEffect Radius="5" Color="Black" DistanceX="5" DistanceY="5" />
                            </Label.Effects>
                        </Label>
                </Grid>
                </Grid>
            </StackLayout>


        </Grid>
        <BoxView x:Name="OverlayBox" BackgroundColor="#000000" Opacity="0" IsVisible="False" />
        <Frame x:Name="ProfilePanel"
               BackgroundColor="{AppThemeBinding Light=#CCfafafa,Dark={StaticResource Night2}}" Padding="0"
               CornerRadius="45" VerticalOptions="EndAndExpand" SizeChanged="ProfilePanel_OnSizeChanged" >
            <StackLayout Margin="8,24,16,8">
                <!--<templates:CloseButton x:Name="CloseBtn" HorizontalOptions="EndAndExpand"/>-->

                <forms1:SvgCachedImage x:Name="CloseBtn" Source="close.svg"
                                       HorizontalOptions="EndAndExpand" Margin="8" WidthRequest="36" HeightRequest="36"
                                       Opacity="0">
                    <forms1:SvgCachedImage.GestureRecognizers>
                        <TapGestureRecognizer Tapped="CloseBtn_OnClicked" />
                    </forms1:SvgCachedImage.GestureRecognizers>
                </forms1:SvgCachedImage>
                <!--first panel -->
                    <Frame VerticalOptions="StartAndExpand" HorizontalOptions="CenterAndExpand" CornerRadius="42"
                           Padding="16" Margin="0,0,0,16">
                        <StackLayout Orientation="Horizontal">
                            <forms:CachedImage
                                WidthRequest="80"
                                HeightRequest="80"
                                Margin="8"
                                Aspect="AspectFit"
                                Source="{Binding User.Image,Converter={StaticResource ProfileImageConverter}}"
                                LoadingPlaceholder="{AppThemeBinding Light=profile_day.png,Dark=profile_night.png}"
                                ErrorPlaceholder="{AppThemeBinding Light=profile_day.png,Dark=profile_night.png}">
                                    <forms:CachedImage.Transformations>
                                        <transformations:CircleTransformation  />
                                    </forms:CachedImage.Transformations>
                            </forms:CachedImage>
                            <StackLayout>
                                <Label Text="{Binding User.DisplayName}" Margin="12,0,0,0" FontSize="16" FontFamily="{StaticResource BoldFont}" />
                                <StackLayout Orientation="Horizontal">
                                    <Button BackgroundColor="Transparent" BorderWidth="1" FontSize="10" BorderColor="Transparent"
                                            Text="{xct:Translate EditProfile}" Padding="8,2" Margin="0" />
                                    <Frame Margin="8,0" Padding="16,0">
                                        <StackLayout Orientation="Horizontal">
                                            <Image Source="gem.png" WidthRequest="24" />
                                            <Label Text="{Binding User.Score}" VerticalOptions="CenterAndExpand"
                                                   TextColor="{StaticResource Gem}" FontSize="16" />
                                        </StackLayout>
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding StoreCommand}"></TapGestureRecognizer>
                                        </Frame.GestureRecognizers>
                                    </Frame>
                                </StackLayout>
                            </StackLayout>
                        </StackLayout>
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop
                                    Color="{AppThemeBinding Light=#914B89,Dark={StaticResource Night2}}"
                                    Offset="0.0" />
                                <GradientStop
                                    Color="{AppThemeBinding Light=#45247A,Dark={StaticResource Night3}}"
                                    Offset="0.15" />
                            </LinearGradientBrush>
                        </Frame.Background>
                    </Frame>
                   
                <Frame CornerRadius="42" HorizontalOptions="CenterAndExpand" HeightRequest="146"
                       Padding="16,8">
                    <Grid ColumnDefinitions="*,*">
                        <userControls:CircularProgressBar Stroke="15" Progress="{Binding UserStatus.MafiaWin}"
                                                          VerticalOptions="Center" HorizontalOptions="Center"
                                                          WidthRequest="60" HeightRequest="60" Color="#FEE9D7" />
                        <userControls:CircularProgressBar Stroke="15" Progress="{Binding UserStatus.CitizenWin}"
                                                          VerticalOptions="Center" HorizontalOptions="Center"
                                                          WidthRequest="100" HeightRequest="100" Color="#F9BF8F" />
                        <userControls:CircularProgressBar Stroke="15" Progress="{Binding UserStatus.TotalWin}"
                                                          VerticalOptions="Center" HorizontalOptions="Center"
                                                          WidthRequest="140" HeightRequest="140" Color="#E2434B" />
                        <StackLayout Grid.Column="1" Margin="8,0,0,0" VerticalOptions="CenterAndExpand">
                            <StackLayout Orientation="Horizontal">
                                <BoxView CornerRadius="36" VerticalOptions="CenterAndExpand" WidthRequest="24"
                                         HeightRequest="24" Color="#E2434B" />
                                <Label VerticalOptions="CenterAndExpand" Margin="8,0,0,0" Text="{xct:Translate WinAsMafia}" />
                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <BoxView CornerRadius="36" VerticalOptions="CenterAndExpand" WidthRequest="24"
                                         HeightRequest="24" Color="#F9BF8F" />
                                <Label VerticalOptions="CenterAndExpand" Margin="8,0,0,0" Text="{xct:Translate WinAsCitizen}" />
                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <BoxView CornerRadius="36" VerticalOptions="CenterAndExpand" WidthRequest="24"
                                         HeightRequest="24" Color="#FEE9D7" />
                                <Label VerticalOptions="CenterAndExpand" Margin="8,0,0,0" Text="{xct:Translate TotalWin}" />
                            </StackLayout>
                        </StackLayout>
                    </Grid>
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop
                                Color="{AppThemeBinding Light=#914B89,Dark={StaticResource Night2}}"
                                Offset="0.0" />
                            <GradientStop
                                Color="{AppThemeBinding Light=#45247A,Dark={StaticResource Night3}}"
                                Offset="0.25" />
                        </LinearGradientBrush>
                    </Frame.Background>
                </Frame>
                <Button Margin="8" Text="{xct:Translate SignOut}" Command="{Binding SignOutCommand}">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop
                                Color="{AppThemeBinding Light={StaticResource Day3},Dark={StaticResource Night3}}"
                                Offset="0.0" />
                            <GradientStop
                                Color="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night4}}"
                                Offset="0.55" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackLayout>
            <Frame.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop
                        Color="{AppThemeBinding Light={StaticResource Day4},Dark={StaticResource Night3}}"
                        Offset="0.0" />
                    <GradientStop
                        Color="{AppThemeBinding Light={StaticResource Day2},Dark={StaticResource Night2}}"
                        Offset="0.5" />
                </LinearGradientBrush>
            </Frame.Background>
        </Frame>

        <forms:CachedImage
            x:Name="ProfileImage"
            WidthRequest="60"
            HeightRequest="60"
            DownsampleToViewSize="True"
            Margin="20"
            Aspect="Fill"
            HorizontalOptions="CenterAndExpand"
            VerticalOptions="EndAndExpand"
            Source="{Binding User.Image,Converter={StaticResource ProfileImageConverter}}"
            LoadingPlaceholder="{AppThemeBinding Light=profile_day.png,Dark=profile_night.png}"
            ErrorPlaceholder="{AppThemeBinding Light=profile_day.png,Dark=profile_night.png}">
            <forms:CachedImage.Transformations>
                <transformations:CircleTransformation x:Name="ProfileCircleTransformation" BorderSize="48" />
            </forms:CachedImage.Transformations>
            <forms:CachedImage.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Up,Down" Swiped="SwipeGestureRecognizer_OnSwiped" />
                <TapGestureRecognizer Tapped="TapGestureRecognizer_OnTapped_" />
            </forms:CachedImage.GestureRecognizers>
        </forms:CachedImage>

    </Grid>
</ContentPage>