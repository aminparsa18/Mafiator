<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
                 xmlns:pages="http://rotorgames.com"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
                 xmlns:forms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
                 xmlns:transformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
                 xmlns:converters="clr-namespace:MafiatorApp.Converters;assembly=MafiatorApp"
                 xmlns:models="clr-namespace:MafiatorApp.Models;assembly=MafiatorApp"
                 xmlns:userControls="clr-namespace:MafiatorApp.UserControls;assembly=MafiatorApp"
                 xmlns:base="clr-namespace:MafiatorApp.ViewModels.Base;assembly=MafiatorApp"
                 xmlns:viewModels="clr-namespace:MafiatorApp.ViewModels;assembly=MafiatorApp" xmlns:shimmerLayout="clr-namespace:MafiatorApp.UserControls.ShimmerLayout"
                 base:ViewModelLocator.AutoWireViewModel="True"
                 x:Class="MafiatorApp.Views.CountriesView"
                 x:DataType="viewModels:CountriesViewModel">
    <pages:PopupPage.Animation>
        <pages:ScaleAnimation
            PositionIn="Bottom"
            PositionOut="Bottom"
            DurationIn="400"
            DurationOut="400"
            EasingIn="SinOut"
            EasingOut="SinIn"
            HasBackgroundAnimation="True" />
    </pages:PopupPage.Animation>
    <pages:PopupPage.Resources>
        <converters:CountryCodelmageConverter x:Key="CountryCodelmageConverter" />
    </pages:PopupPage.Resources>
    <pages:PopupPage.Content>
            <userControls:Popup Margin="24,36">
                <StackLayout>
                <userControls:PopupHeader TitleText="{xct:Translate Select}" SubTitleText="{xct:Translate YourCountry}"/>
                    <Grid  MinimumHeightRequest="60">
                        <userControls:ExtendedEntry  Margin="16,0"
                                                     HeightRequest="60"
                                                    Placeholder="{xct:Translate Search}"
                                                    HorizontalTextAlignment="Center" 
                                                    TextChanged="InputView_OnTextChanged"/>
                        <Image Source="search.png" HorizontalOptions="EndAndExpand" WidthRequest="24" Margin="24,0"></Image>
                    </Grid>
                   
                    <CollectionView
                        ItemsSource="{Binding Countries}"
                        SelectedItem="{Binding Country}"
                        Margin="16,0"
                        SelectionMode="Single"
                        SelectionChangedCommand="{Binding CountrySelectedCommand}">
                    <CollectionView.EmptyView>
                        <ContentView>
                            <shimmerLayout:ShimmerLayout Margin="0,48,0,0" Angle="-45" GradientSize="0.4"
                                                             BackgroundGradientColor="{StaticResource Day4}"
                                                             IsLoading="True">
                                <Grid Padding="24">
                                    <StackLayout Margin="24,8">
                                        <BoxView CornerRadius="12" BackgroundColor="White" HeightRequest="24" />
                                        <BoxView CornerRadius="12" HeightRequest="24" />
                                        <BoxView CornerRadius="12" HeightRequest="24" />
                                    </StackLayout>
                                </Grid>
                            </shimmerLayout:ShimmerLayout>
                        </ContentView>
                    </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Country">
                                <StackLayout Margin="8">
                                    <Frame
                                        BackgroundColor="{AppThemeBinding Light=#ffffff,Dark={StaticResource Night5} }">
                                        <StackLayout Orientation="Horizontal">
                                            <forms:CachedImage
                                                WidthRequest="48"
                                                HeightRequest="30"
                                                VerticalOptions="CenterAndExpand"
                                                DownsampleToViewSize="True"
                                                Margin="8"
                                                Aspect="AspectFit"
                                                Source="{Binding Code,Converter={StaticResource CountryCodelmageConverter}}">
                                                <forms:CachedImage.Transformations>
                                                    <transformations:RoundedTransformation Radius="24" />
                                                </forms:CachedImage.Transformations>
                                            </forms:CachedImage>

                                            <StackLayout Margin="0,8,0,0">
                                                <Label FontSize="Medium" FontFamily="{StaticResource BoldFont}"
                                                       Text="{Binding DialCode}"
                                                       TextColor="{AppThemeBinding Light={StaticResource Night5},Dark=#ffffff}" />
                                                <Label Text="{Binding Name}" FontSize="16"
                                                       TextColor="{AppThemeBinding Light={StaticResource Night5},Dark=#ffffff}" />
                                            </StackLayout>
                                        </StackLayout>
                                    </Frame>

                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
        </userControls:Popup>
    </pages:PopupPage.Content>
</pages:PopupPage>